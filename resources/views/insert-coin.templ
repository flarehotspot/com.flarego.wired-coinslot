package views

import (
	"fmt"
	sdkapi "sdk/api"
)

// mockURL is the synthetic-coin endpoint, set only in dev builds; it is "" in
// production, where no "Mock Insert Coin" button is rendered.
templ InsertCoinPage(api sdkapi.IPluginApi, purchase sdkapi.IPurchaseRequest, coinslotID string, mockURL string) {
	{{
		eventsURL := api.Http().Helpers().UrlForRoute("payments.coin_events", "id", coinslotID)
		doneURL := api.Http().Helpers().UrlForRoute("payments.done")
		price := purchase.Price()
		fixed := purchase.IsFixedPrice()
	}}
	<div
		id="insert-coin-page"
		data-events-url={ eventsURL }
		data-mock-url={ mockURL }
		data-done-url={ doneURL }
		data-price={ fmt.Sprintf("%.2f", price) }
		data-fixed={ fmt.Sprintf("%t", fixed) }
	>
		<h1>{ api.Translate("label", "Insert Coin") }</h1>
		<hr/>
		<p>
			{ api.Translate("label", "Amount Paid") }: <span id="coin-total">0.00</span>
			if fixed {
				<span>{ fmt.Sprintf(" / %.2f", price) }</span>
			}
		</p>
		<p id="coin-status">{ api.Translate("info", "Waiting for coins...") }</p>
		if mockURL != "" {
			<button type="button" class="btn btn-default" id="mock-coin-btn">
				{ api.Translate("label", "Mock Insert Coin") }
			</button>
		}
		<a id="done-btn" class="btn btn-success disabled" href={ templ.SafeURL(doneURL) }>
			{ api.Translate("label", "Done Payment") }
		</a>
	</div>
}
