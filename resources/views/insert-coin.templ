package views

import (
	"fmt"
	sdkapi "sdk/api"
	"context"
    "database/sql"
)

templ InsertCoinPage(tx *sql.Tx, ctx context.Context, api sdkapi.IPluginApi, purchase sdkapi.IPurchaseRequest, coinslotID string) {
	<h1>{ api.Translate("label", "insert_coin") }</h1>
	<hr/>
	<button
		class="btn btn-default"
		type="button"
	 	hx-post={ api.Http().Helpers().UrlForRoute("payments.received", "id", coinslotID, "amount", "1") }
		hx-target="#payment-received"
	>
		{ api.Translate("label", "mock_insert_coin") }
	</button>
	<a class="btn btn-success" href={ templ.SafeURL(api.Http().Helpers().UrlForRoute("payments.done")) }>
		{ api.Translate("label", "done_payment") }
	</a>
	@PaymentReceivedPartial(api, tx, ctx, purchase)
}

templ PaymentReceivedPartial(api sdkapi.IPluginApi, tx *sql.Tx, ctx context.Context, purchase sdkapi.IPurchaseRequest) {
	{{
        var amount float64
        state, err := purchase.State(tx, ctx)
        if err != nil {
            amount = 0
        } else {
            amount = state.TotalPayment
        }
	}}
	<p id="payment-received">{ api.Translate("label", "payment_received") }: { fmt.Sprintf("%.2f", amount) }</p>
}
